# Public demo stand — configuration template.
#
# Copy to `.env` on the stand host. This is not `.env.example`: that template
# describes a laptop, this one describes a machine reachable from the internet.
# Every difference between the two is deliberate and commented below.
#
# The stand runs in `production` mode, not `demo`. Demo mode exists for local
# runs: it serves cookies without `Secure`, allows public registration and role
# self-assignment, and can expose the metrics dashboard. Any of those is a bug
# on a public host, so the stand takes the same hardening as a customer
# installation and differs from it only in content and in the model endpoint.
#
# Accounts are issued, not self-served. A visitor cannot register; you create an
# invitation per prospect. That is a deliberate trade: one manual step per
# prospect buys an attributable session and no anonymous spend on the model.

DEPLOYMENT_MODE=production

# Left empty on purpose: the service refuses to start until it is filled, which
# is the intended behaviour. Generate a fresh value per stand and keep it out of
# the repository:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
API_ACCESS_TOKEN=

# Access control. Production mode refuses to start unless all four hold.
ALLOW_UNAUTHENTICATED_ACCESS=false
AUTH_PUBLIC_REGISTRATION_ENABLED=false
AUTH_ALLOW_ROLE_SELF_ASSIGNMENT=false
AUTH_MIN_PASSWORD_LENGTH=12

# Shorter than the local defaults: a stand link is forwarded around, and a
# session left open on a shared laptop should not survive the working day.
AUTH_SESSION_TTL_SECONDS=28800
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=1800
AUTH_SESSION_RETENTION_SECONDS=604800
AUTH_INVITATION_TTL_SECONDS=259200
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
AUTH_MAX_ACTIVE_SESSIONS=5

# Tighter than the local defaults. The stand is exposed and generation is the
# expensive path; these ceilings are comfortable for a demo session and hostile
# to a script.
RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# The dashboard carries request volume and error rates. Not public anywhere, and
# production mode refuses to start with it open.
METRICS_PUBLIC_ENABLED=false

# The stand has no reason to fetch a video from the internet: prospects upload a
# file. Switching the channel off removes the only outbound path besides the
# model call, and with it the requirement to name an allowed host.
VIDEO_URL_INGEST_ENABLED=false
VIDEO_ALLOWED_HOSTS=

# Bound to loopback. TLS is terminated by the reverse proxy in front, which is
# also what makes the `Secure` cookie flag meaningful.
APP_BIND_HOST=127.0.0.1
APP_PORT=8000

# Set both together when the stand sits behind a proxy: trusting the headers
# without naming the proxy would let any caller claim any address, and
# production mode refuses that combination.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=

# Deterministic by default: the stand demonstrates the product without a key and
# without spend. Switch on and point at an endpoint to show the model path.
# LLM_BASE_URL accepts any OpenAI-compatible URL, which is how the same stand
# can show a customer their own model rather than a foreign vendor's.
OPENAI_ENABLED=false
OPENAI_API_KEY=
LLM_BASE_URL=
LLM_ALLOW_EXTERNAL_CALLS=true

PUBLIC_SOURCES_ENABLED=true
PUBLIC_SOURCES_MAX_RESULTS=15

DATABASE_PATH=generated/app.sqlite3
METRICS_DATABASE_PATH=generated/metrics.sqlite3
RATE_LIMIT_DATABASE_PATH=generated/rate_limits.sqlite3
