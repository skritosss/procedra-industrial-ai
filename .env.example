# Copy this file to `.env` (or `.env.local`, which overrides it) before running
# locally. Both are read; neither is committed.
#
# DEPLOYMENT_MODE defaults to `production` in code, which refuses to start until
# authentication, registration, password length and the video host allowlist are
# configured. This template selects `demo` because it describes a local run.
#
# Deterministic demo mode is the safe default for local runs, Docker, and CI.
# Set OPENAI_ENABLED=true and provide OPENAI_API_KEY for OpenAI-backed generation,
# vision analysis, and semantic embeddings.
OPENAI_ENABLED=false
DEPLOYMENT_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=10

# Video/runtime limits.
VIDEO_MAX_BYTES=262144000
VIDEO_MAX_DURATION_SECONDS=1800
VIDEO_NETWORK_TIMEOUT_SECONDS=15
VIDEO_JOB_LEASE_SECONDS=600
VIDEO_JOB_HEARTBEAT_SECONDS=15
VIDEO_JOB_POLL_SECONDS=1
VIDEO_JOB_MAX_ATTEMPTS=3
VIDEO_JOB_DOWNLOAD_TIMEOUT_SECONDS=900
VIDEO_JOB_EXTRACT_TIMEOUT_SECONDS=900
VIDEO_JOB_ANALYSIS_TIMEOUT_SECONDS=900
VIDEO_JOB_STAGE_POLL_SECONDS=0.25
VISION_MAX_KEYFRAMES=8
VISION_MAX_IMAGE_BYTES=5242880
DOCUMENT_MAX_BYTES=15728640
DATABASE_PATH=generated/app.sqlite3

# Rate-limit buckets. Separate from the business database for the same reason
# as the metrics store: SQLite allows one writer, and limiter bookkeeping must
# not queue behind users, instructions and the audit trail. The contents are
# disposable — losing this file costs at most one limit window.
RATE_LIMIT_DATABASE_PATH=generated/rate_limits.sqlite3

# Durable, bounded-cardinality request metrics. Keep this database separate
# from the business database to avoid sharing its SQLite write lock.
METRICS_DATABASE_PATH=generated/metrics.sqlite3
METRICS_BUCKET_SECONDS=60
METRICS_WINDOW_SECONDS=300
METRICS_RETENTION_SECONDS=604800
METRICS_LATENCY_THRESHOLD_MS=2000
METRICS_AVAILABILITY_SLO_PERCENT=99
METRICS_LATENCY_SLO_PERCENT=95
METRICS_ALERT_MIN_REQUESTS=20
# Demo-only local dashboard escape hatch. Production rejects true.
METRICS_PUBLIC_ENABLED=false

# Optional API protection and abuse limits.
# Leave API_ACCESS_TOKEN empty for local portfolio/demo mode.
# Set it in partner/prod demos and call API endpoints with:
# Authorization: Bearer <token>
API_ACCESS_TOKEN=
# An empty API_ACCESS_TOKEN does not open the API on its own. Unauthenticated
# access is a separate, deliberate switch, and production refuses to start while
# it is true.
ALLOW_UNAUTHENTICATED_ACCESS=true
AUTH_PUBLIC_REGISTRATION_ENABLED=true
AUTH_ALLOW_ROLE_SELF_ASSIGNMENT=true
AUTH_MIN_PASSWORD_LENGTH=8
AUTH_SESSION_TTL_SECONDS=86400
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=3600
AUTH_SESSION_RETENTION_SECONDS=604800
AUTH_INVITATION_TTL_SECONDS=259200
# Per-account brute-force wall. The IP limit above is per address and cannot
# stop a distributed attempt against one account. The lock is temporary on
# purpose: a permanent one lets anyone who knows an email disable that person.
AUTH_MAX_FAILED_ATTEMPTS=10
AUTH_LOCKOUT_SECONDS=900
AUTH_MAX_ACTIVE_SESSIONS=10
RATE_LIMIT_ENABLED=true
# Coarse ceiling over the whole API, all methods. The narrow limits below are
# stricter and apply on top of it. Costs roughly a quarter of API read
# throughput; without it, listing and draining data is unlimited.
API_RATE_LIMIT_REQUESTS=300
API_RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=

# Comma-separated allowlist for video, media CDN, manifest, fragment, and
# subtitle hosts. It is mandatory in production; demo mode may leave it empty
# to allow any host whose every resolved address is public.
# Example only: VIDEO_ALLOWED_HOSTS=youtube.com,youtu.be,googlevideo.com
VIDEO_ALLOWED_HOSTS=

# Public-source retrieval layer.
# Adds open standards, rules, methods, and public reference sources to RAG context.
PUBLIC_SOURCES_ENABLED=true
PUBLIC_SOURCES_MAX_RESULTS=15

# Docker Compose host port. The app always listens on 8000 inside the container.
APP_BIND_HOST=127.0.0.1
APP_PORT=8000
